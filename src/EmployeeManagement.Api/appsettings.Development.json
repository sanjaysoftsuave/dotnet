{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EmployeeManagement": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true
      }
    }
  },
  "RequestLogging": {
    "SlowRequestThresholdMs": 200
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedSampleData": true
  }
}
