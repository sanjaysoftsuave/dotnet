{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EmployeeDb": "Data Source=employees.db"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleData": false
  },
  "RequestLogging": {
    "SlowRequestThresholdMs": 500,
    "CorrelationHeaderName": "X-Correlation-Id"
  },
  "Jwt": {
    "Issuer": "EmployeeManagement.Api",
    "Audience": "EmployeeManagement.Clients",
    "ExpiryMinutes": 60
  },
  "Hiring": {
    "MaxDaysInFuture": 90
  }
}
